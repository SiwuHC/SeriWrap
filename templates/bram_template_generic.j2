/*==============================================================
 *  Description: Generated by SeriWrap
 *  File: {{ module_name }}.v
 *  Type: generic (behavioral, portable)
 *  Author: SeriWrap
 *  Date: {{ generation_date }}
 *
 *  Pure Verilog behavioral dual-port block RAM model.
 *  No vendor IP — infers as block RAM on any modern synthesizer.
 *  Used to validate the wrapper FSM and to enable framework
 *  verification on toolchains that lack the target primitive
 *  (e.g., a 7-series design simulated with a Spartan-6 library).
 *
 *  External port interface matches the rest of the framework:
 *    ADDRA, DIA, CLKA, ENA, WEA, DOA   (port A)
 *    ADDRB, DIB, CLKB, ENB, WEB, DOB   (port B)
 *=============================================================*/
`timescale 1ns / 1ps

module {{ module_name }}(
    input  wire [{{addr_w-1}}:0] ADDRA, ADDRB,
    input  wire [{{width_A-1}}:0]  DIA, DIB,
    input  wire                  CLKA, CLKB,
    input  wire                  ENA, ENB,
    input  wire                  WEA, WEB,
    output reg  [{{width_A-1}}:0]  DOA, DOB
);
    parameter DATA_W  = {{width_A}};
    parameter ADDR_W  = {{addr_w}};
    parameter DEPTH   = {{depth}};

    // ONE shared array: both ports address the same physical memory (that is
    // what a dual-port RAM is).  Port A and port B must therefore have the
    // same geometry; the generator rejects asymmetric requests instead of
    // silently truncating port B.
    reg [DATA_W-1:0] mem [0:DEPTH-1];

    // Initial content.  The primitive templates carry this in their INIT_xx
    // parameters; a behavioural model has none, so the same data is loaded
    // here.  Without this the array comes up as X in a 4-state simulator even
    // when the caller supplied a MIF, and "no initialisation" was silently
    // indistinguishable from "initialised with zeros".
    integer _init_i;
    initial begin
        for (_init_i = 0; _init_i < DEPTH; _init_i = _init_i + 1)
            mem[_init_i] = {DATA_W{1'b0}};
{% for addr, val in init_words %}
        mem[{{ addr }}] = {{ width_A }}'h{{ '%X'|format(val) }};
{% endfor %}
    end

    // Port A: 1-clock REGISTERED read (read-first) + synchronous write.
    // Cycle-accurate with every primitive this tool emits (RAMB4_S*,
    // RAMB8BWER, RAMB18E1, RAMB36E1): DO is valid one clock after EN/ADDR
    // are applied, and EN low holds the previous output.
    // NOTE: this model used to have a combinational read, which no real
    // primitive has; the wrapper's LAUNCH FSM budgeted one clock per word
    // and therefore mis-read every word except the first on real hardware.
    always @(posedge CLKA) begin
        if (ENA) DOA <= mem[ADDRA];
        if (ENA && WEA) mem[ADDRA] <= DIA;
    end


    // Port B: 1-clock REGISTERED read (read-first) + synchronous write.
    always @(posedge CLKB) begin
        if (ENB) DOB <= mem[ADDRB];
        if (ENB && WEB) mem[ADDRB] <= DIB;
    end

endmodule
