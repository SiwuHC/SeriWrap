 *
 *  Instantiates one or more RAMB8BWER primitives (1KB each) to
 *  build the requested (width, depth) dual-port BRAM.  When the
 *  total bit count exceeds 1KB, multiple primitives are bit-sliced
 *  along the data width (same scheme as RAMB4_S*, just smaller
 *  primitive).
 *
 *  Each primitive uses INIT_00..INIT_0F (16 lines, 64 bits each =
 *  1024 bits total).  Addresses per INIT line = 64 / width_A_one.
 *=============================================================*/
`timescale 1ns / 1ps

{% if width_B == 0 %}
module {{ module_name }}(ADDRA, DIA, CLKA, ENA, WEA, DOA);
{% else %}
module {{ module_name }}(ADDRA, DIA, CLKA, ENA, WEA, DOA, ADDRB, DIB, CLKB, ENB, WEB, DOB);
{% endif %}

  input [{{depth_A-1}}:0] ADDRA;
  input [{{width_A-1}}:0] DIA;
  input CLKA;
  input ENA;
  input WEA;
  output [{{width_A-1}}:0] DOA;
{% if width_B > 0 %}
  input [{{depth_B-1}}:0] ADDRB;
  input [{{width_B-1}}:0] DIB;
  input CLKB;
  input ENB;
  input WEB;
  output [{{width_B-1}}:0] DOB;
{% endif %}

{% if width_B == 0 %}
{% for j in range(module_number) %}
RAMB8BWER ram{{j}}(
    .ADDRA({{ addr_a_expr }}),
    .CLKA (CLKA),
    .RSTA (1'b0),
    .ENA  (ENA),
    .WEA  (WEA),
    .DIA  (DIA[{{(j+1)*width_A_one-1}}:{{j*width_A_one}}]),
    .DOA  (DOA[{{(j+1)*width_A_one-1}}:{{j*width_A_one}}])
);
{% for i in range(16) %}
defparam ram{{j}}.INIT_{{ "%02X"|format(i) }} = {{ init_data[j][i] }};
{% endfor %}
{% endfor %}

{% else %}
{% for j in range(module_number) %}
RAMB8BWER ram{{j}}(
    .ADDRA({{ addr_a_expr }}),
    .CLKA (CLKA),
    .RSTA (1'b0),
    .ENA  (ENA),
    .WEA  (WEA),
    .DIA  (DIA[{{(j+1)*width_A_one-1}}:{{j*width_A_one}}]),
    .DOA  (DOA[{{(j+1)*width_A_one-1}}:{{j*width_A_one}}]),
    .ADDRB({{ addr_b_expr }}),
    .CLKB (CLKB),
    .RSTB (1'b0),
    .ENB  (ENB),
    .WEB  (WEB),
    .DIB  (DIB[{{(j+1)*width_B_one-1}}:{{j*width_B_one}}]),
    .DOB  (DOB[{{(j+1)*width_B_one-1}}:{{j*width_B_one}}])
);
{% for i in range(16) %}
defparam ram{{j}}.INIT_{{ "%02X"|format(i) }} = {{ init_data[j][i] }};
{% endfor %}
{% endfor %}
{% endif %}

endmodule
