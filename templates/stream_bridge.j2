`timescale 1ns / 1ps


module {{ top_module }}__stream_bridge #(
    parameter ADDR_W          = {{ addr_w }},
    parameter WIDTH           = {{ width }},
    parameter TRIGGER_BIT     = {{ trigger_bit }},
    parameter USE_TRIGGER_BIT = {{ use_trigger_bit|int }}
) (
    input  wire                    clk,
    input  wire                    rst_n,

    // Soft batch reset (mirrors SIPO).  Bridge ignores this — there is
    // no synchronizer chain to clear.
    input  wire                    batch_arm,

    // Adapter-direct inputs.  In PS/2 mode key_state[TRIGGER_BIT] is
    // monitored; event_in is unused.  In event mode (UART/GPIO) the
    // adapter's 1-cycle pulse is wired to event_in and key_state is
    // tied to 0.
    input  wire [63:0]             key_state,
    input  wire                    event_in,

    // SIPO-compatible outputs for wrapper FSM
    output reg                     done,             // pulse for 1 cycle on trigger
    output reg                     overflow,         // never asserted
    output reg  [ADDR_W-1:0]       write_count,      // always 0 -- reg keeps width

    // SIPO-compatible BRAM interface (unused, tied to 0)
    output reg  [ADDR_W-1:0]       bram_addr,
    output reg  [WIDTH-1:0]        bram_din,
    output reg                     bram_we
);

    // ----------------------------------------------------------------
    // Trigger detector: rising edge of either key_state[TRIGGER_BIT]
    // (PS/2 mode) or event_in (event mode).  In event mode the input is
    // already a 1-cycle pulse, so prev_trigger acts as a 1-cycle delay
    // line and the output mirrors the input.
    // ----------------------------------------------------------------
    reg prev_trigger;
    wire trigger_now  = USE_TRIGGER_BIT ? key_state[TRIGGER_BIT] : event_in;
    wire trigger_rise = trigger_now & ~prev_trigger;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            prev_trigger <= 1'b0;
            done         <= 1'b0;
            overflow     <= 1'b0;
            write_count  <= {ADDR_W{1'b0}};
            bram_addr    <= {ADDR_W{1'b0}};
            bram_din     <= {WIDTH{1'b0}};
            bram_we      <= 1'b0;
        end else begin
            prev_trigger <= trigger_now;
            done         <= trigger_rise;
            overflow     <= 1'b0;
            write_count  <= {ADDR_W{1'b0}};
            bram_addr    <= {ADDR_W{1'b0}};
            bram_din     <= {WIDTH{1'b0}};
            bram_we      <= 1'b0;
        end
    end

endmodule