`timescale 1ns / 1ps


/*
 *  Parallel-N-bit Parallel-In-Serial-Out with BRAM read.
 *
 *  On `start`, drives BRAM address and reads COUNT words from
 *  bram_dout, presenting them on s_data_out in parallel.  Toggles
 *  s_clk_out at BAUD_DIV half-period.  Rabbit samples s_data_out
 *  on each s_clk_out rising edge (with s_data_valid == 1).
 *  s_data_out updates on s_clk_out falling edge.
 *
 *  Parameters:
 *    WIDTH    - bit width of each parallel data word
 *    COUNT    - number of words to send
 *    BAUD_DIV - system clocks per half period of s_clk_out
 *    ADDR_W   - BRAM address bus width
 *=============================================================*/

module {{ top_module }}__stream_piso #(
    parameter WIDTH    = {{ width }},
    parameter COUNT    = {{ count }},
    parameter BAUD_DIV = {{ baud_div }},
    parameter ADDR_W   = {{ addr_w }}
) (
    input  wire               clk,        // system clock
    input  wire               rst_n,
    input  wire               start,

    // BRAM read interface (Port B)
    output reg  [ADDR_W-1:0]  bram_addr,
    input  wire [WIDTH-1:0]   bram_dout,

    // Parallel output to Rabbit
    output reg  [WIDTH-1:0]   s_data_out,
    output reg                s_clk_out,
    output reg                s_data_valid,

    // Status
    output reg                busy,
    output reg                done
);

    reg [1:0]                       state;
    reg [$clog2(BAUD_DIV):0]        tick_cnt;
    reg [ADDR_W-1:0]                word_cnt;

    wire tick = (tick_cnt == BAUD_DIV - 1);

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            state        <= 2'd0;     // ST_IDLE
            tick_cnt     <= 0;
            word_cnt     <= 0;
            bram_addr    <= 0;
            s_data_out   <= 0;
            s_clk_out    <= 1'b0;
            s_data_valid <= 1'b0;
            busy         <= 1'b0;
            done         <= 1'b0;
        end else begin
            done <= 1'b0;

            case (state)
                2'd0: begin  // ST_IDLE
                    s_data_valid <= 1'b0;
                    s_clk_out    <= 1'b0;
                    busy         <= 1'b0;
                    // Explicitly keep Port B at addr 0 while idle so
                    // BRAM's registered DOB latches mem[0].  When the
                    // next start pulse fires, s_data_out <- bram_dout
                    // samples mem[0] without any settle-cycle race,
                    // regardless of what address ST_SEND left behind.
                    bram_addr    <= 0;
                    if (start) begin
                        s_data_valid <= 1'b1;
                        s_clk_out    <= 1'b0;
                        busy         <= 1'b1;
                        word_cnt     <= 0;
                        // Pre-read: addr 0 was latched during idle,
                        // so bram_dout already = mem[0].  Advance to
                        // addr 1 so mem[1] is ready for the first
                        // falling-edge update.
                        bram_addr    <= 1;
                        s_data_out   <= bram_dout;
                        state        <= 2'd1;     // ST_SEND
                    end
                end

                2'd1: begin  // ST_SEND
                    tick_cnt <= tick_cnt + 1;
                    if (tick) begin
                        tick_cnt <= 0;
                        s_clk_out <= ~s_clk_out;
                        if (s_clk_out == 1'b1) begin
                            // We just toggled clk_out low.  Update
                            // data_out for the next rising edge.
                            if (word_cnt == COUNT - 1) begin
                                state <= 2'd2;  // ST_DONE
                            end else begin
                                word_cnt  <= word_cnt + 1;
                                bram_addr <= bram_addr + 1;
                                s_data_out <= bram_dout;  // 1 cycle later
                            end
                        end
                    end
                end

                2'd2: begin  // ST_DONE
                    s_data_valid <= 1'b0;
                    s_clk_out    <= 1'b0;
                    busy         <= 1'b0;
                    done         <= 1'b1;
                    state        <= 2'd0;     // back to ST_IDLE
                end

                default: state <= 2'd0;
            endcase
        end
    end

endmodule
