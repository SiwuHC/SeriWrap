/*==============================================================
 *  Description: Generated by SeriWrap
 *  File: {{ top_module }}__stream_top.v
 *  Author: SeriWrap
 *  Date: {{ generation_date }}
 *
 *  New top-level module exposing the serial interface and any
 *  control ports.  Forwards all signals to the stream wrapper.
 *=============================================================*/
`timescale 1ns / 1ps

{% set has_ctrl = control_input_ports|length > 0 or control_output_ports|length > 0 %}
{% set serial_ports = (input_count > 0) or (output_count > 0) %}
{# Real adapter pin count: ps2 = 2 pins, uart/gpio = 1 pin.  The old comma
   guards used adapters|length, so a uart/gpio adapter (whose loop body emits
   nothing) left a dangling comma and the top did not compile. #}
{% set ns = namespace(adpins=0) %}
{% for ad in adapters %}
{% if ad.name == 'ps2' %}{% set ns.adpins = ns.adpins + 2 %}
{% elif ad.name in ('uart', 'gpio') %}{% set ns.adpins = ns.adpins + 1 %}
{% endif %}
{% endfor %}

module {{ top_module }}__stream_top (
    input  wire                  clk,
    input  wire                  rst_n{% if serial_ports or has_ctrl or ns.adpins > 0 or debug or expose_ready %},{% endif %}
{%- if expose_ready %}

    // Back-pressure from the wrapper: HIGH while a new frame may be driven
    output wire                  s_ready{% if serial_ports or has_ctrl or ns.adpins > 0 or debug %},{% endif %}
{%- endif %}
{%- if input_count > 0 %}

    // Serial input from Rabbit
    input  wire [{{ WIDTH - 1 }}:0]  s_data_in,
    input  wire                  s_clk_in,
    input  wire                  s_strobe_in{% if output_count > 0 or has_ctrl or debug %},{% endif %}
{% endif %}
{%- if output_count > 0 %}

    // Serial output to Rabbit
    output wire [{{ WIDTH - 1 }}:0]  s_data_out,
    output wire                  s_clk_out,
    output wire                  s_data_valid{% if has_ctrl or ns.adpins > 0 or debug %},{% endif %}
{% endif %}
{%- for cp in control_input_ports %}

    // Control input: {{ cp.name }}
    input  wire {% if cp.width > 1 %}[{{ cp.width - 1 }}:0] {% endif %} ctrl_{{ cp.name }}{% if not loop.last or control_output_ports|length > 0 or debug %},{% endif %}
{% endfor %}
{%- for cp in control_output_ports %}

    // Control output: {{ cp.name }}
    output wire {% if cp.width > 1 %}[{{ cp.width - 1 }}:0] {% endif %} ctrl_{{ cp.name }}{% if not loop.last or debug or adapters|length > 0 %},{% endif %}
{% endfor %}
{%- for ad in adapters %}
{% if ad.name == 'ps2' %}

    // Physical device adapter pins: ps2
    input  wire                  ps2_clk,
    input  wire                  ps2_data{% if not loop.last or debug %},{% endif %}
{% elif ad.name == 'uart' %}

    // Physical device adapter pin: uart
    input  wire                  uart_rx{% if not loop.last or debug %},{% endif %}
{% elif ad.name == 'gpio' %}

    // Physical device adapter pin: gpio
    input  wire                  gpio_in{% if not loop.last or debug %},{% endif %}
{% endif %}
{%- endfor %}
{%- if debug %}

    // Debug status
    output wire                  overflow,
    output wire                  idle,
    output wire                  busy
{% endif %}
);

    parameter WIDTH = {{ WIDTH }};
    parameter DEPTH = {{ depth }};

    {{ stream_module }} u_wrap (
        .clk          (clk),
        .rst_n        (rst_n){% if input_count > 0 or output_count > 0 or control_input_ports|length > 0 or control_output_ports|length > 0 or ns.adpins > 0 or debug or expose_ready %},{% endif %}
{%- if expose_ready %}
        .s_ready      (s_ready){% if input_count > 0 or output_count > 0 or control_input_ports|length > 0 or control_output_ports|length > 0 or ns.adpins > 0 or debug %},{% endif %}
{%- endif %}
{%- if input_count > 0 %}

        .s_data_in    (s_data_in),
        .s_clk_in     (s_clk_in),
        .s_strobe_in  (s_strobe_in){% if output_count > 0 or control_input_ports|length > 0 or control_output_ports|length > 0 or ns.adpins > 0 or debug %},{% endif %}
{% endif %}
{%- if output_count > 0 %}

        .s_data_out   (s_data_out),
        .s_clk_out    (s_clk_out),
        .s_data_valid (s_data_valid){% if control_input_ports|length > 0 or control_output_ports|length > 0 or ns.adpins > 0 or debug %},{% endif %}
{% endif %}
{%- for cp in control_input_ports %}

        .ctrl_{{ cp.name }} (ctrl_{{ cp.name }}){% if not loop.last or control_output_ports|length > 0 or adapters|length > 0 or debug %},{% endif %}
{% endfor %}
{%- for cp in control_output_ports %}

        .ctrl_{{ cp.name }} (ctrl_{{ cp.name }}){% if not loop.last or adapters|length > 0 or debug %},{% endif %}
{% endfor %}
{%- for ad in adapters %}
{% if ad.name == 'ps2' %}

        .ps2_clk      (ps2_clk),
        .ps2_data     (ps2_data){% if not loop.last or debug %},{% endif %}
{% elif ad.name == 'uart' %}

        .uart_rx      (uart_rx){% if not loop.last or debug %},{% endif %}
{% elif ad.name == 'gpio' %}

        .gpio_in      (gpio_in){% if not loop.last or debug %},{% endif %}
{% endif %}
{%- endfor %}
{%- if debug %}

        .overflow     (overflow),
        .idle         (idle),
        .busy         (busy)
{% endif %}
    );

endmodule
