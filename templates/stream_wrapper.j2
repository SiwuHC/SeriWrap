/*==============================================================
 *  Description: Generated by SeriWrap
 *  File: {{ top_module }}__stream_wrapper.v
 *  Author: SeriWrap
 *  Date: {{ generation_date }}
 *
 *  Wraps user module `{{ top_module }}` with SIPO/PISO/BRAM glue
 *  to expose a parallel-N-bit 3-wire serial interface.
 *
 *  Port classification:
 *    - Handshake (clk/rst_n/start/done/busy): auto-detected
 *    - Control ports: exposed on wrapper top-level
 *    - Data ports: serialized through SIPO→BRAM→...→PISO
 *
 *  Heterogeneous widths supported: each data port keeps its
 *  declared width; ports wider than WIDTH span multiple BRAM
 *  entries (little-endian order).
 *
 *  External ports:
 *    s_data_in[WIDTH-1:0], s_clk_in, s_strobe_in
 *    s_data_out[WIDTH-1:0], s_clk_out, s_data_valid
 *    control_input_*    (if any)
 *    control_output_*   (if any)
 *    overflow, idle, busy (if --debug)
 *
 *  Internal: instantiates stream_sipo, stream_piso, the user
 *  module, and two dual-port BRAMs.
 *
 *  FSM:
 *    C_IDLE      → wait for src_done
 *    C_LAUNCH    → copy INPUT_COUNT words from in_bram to in_bram_buf,
 *                   then assemble heterogeneous port wires
 *    C_COMPUTING → pulse user.start, wait for user.done
 *    C_DUMP      → disassemble user outputs into out_buf, write to BRAM
 *    C_DONE      → trigger PISO
 *
 *  Companion files:
 *    - {{ top_module }}__stream_sipo.v
 *    - {{ top_module }}__stream_piso.v
 *    - {{ top_module }}__stream_bram.v
 *    - {{ user_source }}  (user module)
 *=============================================================*/
`timescale 1ns / 1ps

{% set has_ctrl = control_input_ports|length > 0 or control_output_ports|length > 0 %}
{% set serial_ports = (input_count > 0) or (output_count > 0) %}

module {{ wrapper_module }} (
    input  wire                  clk,
    input  wire                  rst_n{% if serial_ports or has_ctrl or debug or expose_ready %},{% endif %}
{%- if expose_ready %}

    // Back-pressure: HIGH while the wrapper can accept a new frame.  A host
    // must only strobe words while s_ready is high; each frame is exactly
    // INPUT_COUNT words.  Without this signal a producer that starts the
    // next frame too early silently loses its head words.
    output wire                  s_ready{% if serial_ports or has_ctrl or debug %},{% endif %}
{%- endif %}
{%- if input_count > 0 %}

    // Serial input from Rabbit
    input  wire [{{ WIDTH - 1 }}:0]  s_data_in,
    input  wire                  s_clk_in,
    input  wire                  s_strobe_in{% if output_count > 0 or has_ctrl or debug %},{% endif %}
{%- endif %}
{%- if output_count > 0 %}

    // Serial output to Rabbit
    output wire [{{ WIDTH - 1 }}:0]  s_data_out,
    output wire                  s_clk_out,
    output wire                  s_data_valid{% if has_ctrl or adapters|length > 0 or debug %},{% endif %}
{%- endif %}
{%- for cp in control_input_ports %}

    // Control input: {{ cp.name }}
    input  wire {% if cp.width > 1 %}[{{ cp.width - 1 }}:0] {% endif %} ctrl_{{ cp.name }}{% if not loop.last or control_output_ports|length > 0 or debug or adapters|length > 0 %},{% endif %}
{%- endfor %}
{%- for cp in control_output_ports %}

    // Control output: {{ cp.name }}
    output wire {% if cp.width > 1 %}[{{ cp.width - 1 }}:0] {% endif %} ctrl_{{ cp.name }}{% if not loop.last or debug or adapters|length > 0 %},{% endif %}
{%- endfor %}
{%- for ad in adapters %}
{% if ad.name == 'ps2' %}

    // Physical device adapter pins: {{ ad.name }}
    input  wire                  ps2_clk,
    input  wire                  ps2_data{% if not loop.last or debug %},{% endif %}
{% elif ad.name == 'uart' %}

    // Physical device adapter pin: {{ ad.name }}
    input  wire                  uart_rx{% if not loop.last or debug %},{% endif %}
{% elif ad.name == 'gpio' %}

    // Physical device adapter pin: {{ ad.name }}
    input  wire                  gpio_in{% if not loop.last or debug %},{% endif %}
{% endif %}
{%- endfor %}
{%- if debug %}

    // Debug status
    output wire                  overflow,
    output wire                  idle,
    output wire                  busy
{%- endif %}
);

    parameter WIDTH        = {{ WIDTH }};
    parameter DEPTH        = {{ depth }};
    parameter ADDR_W       = {{ addr_w }};
    parameter EXT_ADDR_W   = {{ ext_addr_w }};
    parameter NUM_IN_BRAMS  = {{ num_in_brams }};
    parameter NUM_OUT_BRAMS = {{ num_out_brams }};
    parameter BRAM_SEL_W   = {{ bram_sel_w }};
    parameter INPUT_COUNT  = {{ input_count }};
    parameter OUTPUT_COUNT = {{ output_count }};
    parameter IN_IDX_W     = {{ input_count_idx_w }};
    parameter OUT_IDX_W    = {{ output_count_idx_w }};

    // ------------------------------------------------------------------
    // Registers referenced by instantiation port lists and by wires that
    // are declared above them MUST be declared here: Verilog-2001 makes an
    // undeclared identifier in a port list an implicit 1-bit wire, and the
    // later "reg" declaration then fails with "already implicitly declared"
    // in every non-SystemVerilog flow (Vivado xvlog, ModelSim vlog,
    // iverilog, Verilator).  See PROJECT_DOCS for the original failure.
    // ------------------------------------------------------------------
{% if input_count > 0 %}
    reg [EXT_ADDR_W-1:0]  in_bram_rd_addr;
    // Port-B read enable for the input BRAM.  Held LOW outside C_LAUNCH so
    // the BRAM port B does not collide with port-A writes (SIPO or C_DUMP).
    reg               in_bram_re;
    // 1-cycle pulse to SIPO at the end of each batch, resetting
    // write_count and the synchronizer chain so the next batch can
    // be captured.
    reg               src_arm;
{% endif %}
{% if output_count > 0 %}
    reg [EXT_ADDR_W-1:0]  out_bram_wr_addr;
    reg [WIDTH-1:0]   out_bram_din;
    reg               out_bram_we;
    // Port-B read enable for the output BRAM.
    reg               out_bram_re;
{% endif %}
{% if user_has_handshake %}
    reg [IN_IDX_W-1:0]  launch_idx;      // next address to ISSUE
    reg [IN_IDX_W-1:0]  launch_cap;      // next entry to CAPTURE (trails launch_idx)
    reg [OUT_IDX_W-1:0] dump_idx;
    reg [1:0]           launch_pipe;
    // one word can be issued every clock as long as entries remain
    wire                launch_issue = (launch_idx < INPUT_COUNT);
{% endif %}

{% if input_count > 0 %}
    // ============================================================
    // SIPO: writes each strobed word from s_data_in to in_bram
    // ============================================================
    wire [EXT_ADDR_W-1:0]  src_addr;
    wire [WIDTH-1:0]   src_din;
    wire               src_we;
    wire [EXT_ADDR_W-1:0]  src_wcnt;
    wire               src_done;
    wire               src_ovf;

    {{ top_module }}__stream_sipo u_sipo (
        .clk          (clk),
        .rst_n        (rst_n),
        .data_in      (s_data_in),
        .clk_in       (s_clk_in),
        .strobe_in    (s_strobe_in),
        .bram_addr    (src_addr),
        .bram_din     (src_din),
        .bram_we      (src_we),
        .write_count  (src_wcnt),
        .done         (src_done),
        .overflow     (src_ovf),
        .batch_arm    (src_arm)
    );

    // Input BRAM(s): SIPO writes Port A, wrapper reads Port B
    // Multi-BRAM: upper EXT_ADDR_W bits select BRAM instance
{% if num_in_brams == 1 %}
    wire [WIDTH-1:0]   in_bram_doa_unused;
    wire [WIDTH-1:0]   in_bram_dob;

    {{ bram_module }} u_in_bram (
        .ADDRA(src_addr[ADDR_W-1:0]),
        .DIA  (src_din),
        .CLKA (clk),
        .ENA  (1'b1),
        .WEA  (src_we),
        .DOA  (in_bram_doa_unused),
        .ADDRB(in_bram_rd_addr[ADDR_W-1:0]),
        .DIB  ({WIDTH{1'b0}}),
        .CLKB (clk),
        .ENB  (in_bram_re),
        .WEB  (1'b0),
        .DOB  (in_bram_dob)
    );
{% else %}
    wire [WIDTH-1:0]   in_bram_doa_unused [0:NUM_IN_BRAMS-1];
    wire [WIDTH-1:0]   in_bram_dob_arr [0:NUM_IN_BRAMS-1];
    wire [WIDTH-1:0]   in_bram_dob;
    // BRAM select from SIPO write address (port A) and FSM read address (port B)
    wire [BRAM_SEL_W-1:0] in_bram_wr_sel = src_addr[EXT_ADDR_W-1:ADDR_W];
    wire [BRAM_SEL_W-1:0] in_bram_rd_sel = in_bram_rd_addr[EXT_ADDR_W-1:ADDR_W];
    // Read-select pipeline: every emitted memory has a 1-clock registered
    // read, so the instance whose DOB is valid on the bus is selected by the
    // read address of the PREVIOUS cycle.  A 2-cycle delay (the previous
    // code) selected the wrong instance one word after every bank crossing.
    reg  [BRAM_SEL_W-1:0] in_bram_rd_sel_d1;

    genvar _gi;
    generate for (_gi = 0; _gi < NUM_IN_BRAMS; _gi = _gi + 1) begin : in_bram_gen
        wire _wr_hit = (in_bram_wr_sel == _gi);
        {{ bram_module }} u_in_bram (
            .ADDRA(src_addr[ADDR_W-1:0]),
            .DIA  (src_din),
            .CLKA (clk),
            .ENA  (1'b1),
            .WEA  (src_we && _wr_hit),
            .DOA  (in_bram_doa_unused[_gi]),
            .ADDRB(in_bram_rd_addr[ADDR_W-1:0]),
            .DIB  ({WIDTH{1'b0}}),
            .CLKB (clk),
            .ENB  (in_bram_re),
            .WEB  (1'b0),
            .DOB  (in_bram_dob_arr[_gi])
        );
    end
    endgenerate

    assign in_bram_dob = in_bram_dob_arr[in_bram_rd_sel_d1];
{% endif %}
{% elif input_source == 'adapter' %}
    // ============================================================
    // Bridge: SIPO drop-in replacement for --input-source adapter.
    // Two operating modes, both producing a 1-cycle `src_done` pulse:
    //   PS/2 mode     — key_state[TRIGGER_BIT] rising edge
    //   Event mode    — UART data_valid / GPIO gpio_event pulse
    // There is no input BRAM in adapter mode (input_count == 0).
    // ============================================================
    wire [EXT_ADDR_W-1:0]  src_addr;
    wire [WIDTH-1:0]   src_din;
    wire               src_we;
    wire [EXT_ADDR_W-1:0]  src_wcnt;
    wire               src_done;
    wire               src_ovf;

{% for ad in adapters %}
{% if ad.name == 'ps2' %}
    {{ top_module }}__stream_bridge #(
        .TRIGGER_BIT({{ trigger_bit }}),
        .USE_TRIGGER_BIT(1)
    ) u_bridge (
        .clk          (clk),
        .rst_n        (rst_n),
        .key_state    (ad_ps2_key_state),
        .event_in     (1'b0),
        .done         (src_done),
        .overflow     (src_ovf),
        .bram_addr    (src_addr),
        .bram_din     (src_din),
        .bram_we      (src_we),
        .write_count  (src_wcnt),
        .batch_arm    (1'b0)
    );
{% elif ad.name == 'uart' %}
    {{ top_module }}__stream_bridge #(
        .TRIGGER_BIT(0),
        .USE_TRIGGER_BIT(0)
    ) u_bridge (
        .clk          (clk),
        .rst_n        (rst_n),
        .key_state    (64'd0),
        .event_in     (ad_uart_data_valid),
        .done         (src_done),
        .overflow     (src_ovf),
        .bram_addr    (src_addr),
        .bram_din     (src_din),
        .bram_we      (src_we),
        .write_count  (src_wcnt),
        .batch_arm    (1'b0)
    );
{% elif ad.name == 'gpio' %}
    {{ top_module }}__stream_bridge #(
        .TRIGGER_BIT(0),
        .USE_TRIGGER_BIT(0)
    ) u_bridge (
        .clk          (clk),
        .rst_n        (rst_n),
        .key_state    (64'd0),
        .event_in     (ad_gpio_gpio_event),
        .done         (src_done),
        .overflow     (src_ovf),
        .bram_addr    (src_addr),
        .bram_din     (src_din),
        .bram_we      (src_we),
        .write_count  (src_wcnt),
        .batch_arm    (1'b0)
    );
{% endif %}
{% endfor %}
{% endif %}
{% if output_count > 0 %}

    // PISO interface.  Declared BEFORE the output BRAM instantiations: the
    // multi-bank select logic below reads piso_addr, and using a net before its
    // declaration is an error for strict Verilog analysis (Vivado synthesis
    // silently creates an implicit net, which is how this slipped through).
    wire [EXT_ADDR_W-1:0]  piso_addr;
    wire [WIDTH-1:0]   piso_data_out;
    wire               piso_clk_out;
    wire               piso_data_valid;
    wire               piso_busy;
    wire               piso_done;
    reg                piso_start;
    reg                piso_triggered;

    // Output BRAM(s): wrapper writes Port A, PISO reads Port B
{% if num_out_brams == 1 %}
    wire [WIDTH-1:0]   out_bram_doa_unused;
    wire [WIDTH-1:0]   out_bram_dob;

    {{ bram_module }} u_out_bram (
        .ADDRA(out_bram_wr_addr[ADDR_W-1:0]),
        .DIA  (out_bram_din),
        .CLKA (clk),
        .ENA  (1'b1),
        .WEA  (out_bram_we),
        .DOA  (out_bram_doa_unused),
        .ADDRB(piso_addr[ADDR_W-1:0]),
        .DIB  ({WIDTH{1'b0}}),
        .CLKB (clk),
        .ENB  (out_bram_re),
        .WEB  (1'b0),
        .DOB  (out_bram_dob)
    );
{% else %}
    wire [WIDTH-1:0]   out_bram_doa_unused [0:NUM_OUT_BRAMS-1];
    wire [WIDTH-1:0]   out_bram_dob_arr [0:NUM_OUT_BRAMS-1];
    wire [WIDTH-1:0]   out_bram_dob;
    // BRAM select from write address (port A) and PISO read address (port B)
    wire [BRAM_SEL_W-1:0] out_bram_wr_sel = out_bram_wr_addr[EXT_ADDR_W-1:ADDR_W];
    wire [BRAM_SEL_W-1:0] out_bram_rd_sel = piso_addr[EXT_ADDR_W-1:ADDR_W];
    // Same 1-clock read-select pipeline as the input side (see above).
    reg  [BRAM_SEL_W-1:0] out_bram_rd_sel_d1;

    genvar _go;
    generate for (_go = 0; _go < NUM_OUT_BRAMS; _go = _go + 1) begin : out_bram_gen
        wire _wr_hit = (out_bram_wr_sel == _go);
        {{ bram_module }} u_out_bram (
            .ADDRA(out_bram_wr_addr[ADDR_W-1:0]),
            .DIA  (out_bram_din),
            .CLKA (clk),
            .ENA  (1'b1),
            .WEA  (out_bram_we && _wr_hit),
            .DOA  (out_bram_doa_unused[_go]),
            .ADDRB(piso_addr[ADDR_W-1:0]),
            .DIB  ({WIDTH{1'b0}}),
            .CLKB (clk),
            .ENB  (out_bram_re),
            .WEB  (1'b0),
            .DOB  (out_bram_dob_arr[_go])
        );
    end
    endgenerate

    assign out_bram_dob = out_bram_dob_arr[out_bram_rd_sel_d1];
{% endif %}

    // ============================================================
    // PISO: reads OUTPUT_COUNT words from out_bram and sends them out
    // ============================================================
    assign s_data_out   = piso_data_out;
    assign s_clk_out    = piso_clk_out;
    assign s_data_valid = piso_data_valid;

    {{ top_module }}__stream_piso u_piso (
        .clk          (clk),
        .rst_n        (rst_n),
        .start        (piso_start),
        .bram_addr    (piso_addr),
        .bram_dout    (out_bram_dob),
        .s_data_out   (piso_data_out),
        .s_clk_out    (piso_clk_out),
        .s_data_valid (piso_data_valid),
        .busy         (piso_busy),
        .done         (piso_done)
    );
{% endif %}

    // ============================================================
    // User module I/O wires
    // ============================================================
{% if input_count > 0 %}
    // in_bram_buf: raw BRAM data, one WIDTH-bit entry per chunk
    reg  [WIDTH-1:0]  in_bram_buf [0:INPUT_COUNT-1];
{% endif %}
{% if output_count > 0 %}
    // out_buf: WIDTH-bit chunks to write to output BRAM
    wire [WIDTH-1:0]  out_buf [0:OUTPUT_COUNT-1];
{% endif %}

    // ── Data input port wires (assembled from in_bram_buf) ──
{% for p in input_chunked %}
    wire [{{ p.width - 1 }}:0] user_in_w_{{ p.name }};
{% for c in p.chunks %}
{% if c.port_hi is defined %}
    assign user_in_w_{{ p.name }}[{{ c.port_hi }}:{{ c.port_lo }}] = in_bram_buf[{{ c.bram_idx }}][{{ c.bram_hi }}:{{ c.bram_lo }}];
{% else %}
    assign user_in_w_{{ p.name }}[{{ c.hi }}:{{ c.lo }}] = in_bram_buf[{{ c.bram_idx }}][{{ c.hi - c.lo }}:0];
{% endif %}
{% endfor %}
{% endfor %}

    // ── Data output port wires ──
{% for p in output_chunked %}
    wire [{{ p.width - 1 }}:0] user_out_w_{{ p.name }};
{% endfor %}

    // ── Control output wires ──
{% for cp in control_output_ports %}
    wire {% if cp.width > 1 %}[{{ cp.width - 1 }}:0] {% endif %} user_ctrl_out_{{ cp.name }};
    assign ctrl_{{ cp.name }} = user_ctrl_out_{{ cp.name }};
{% endfor %}

    // ── out_buf disassembly: user_out_w_* → out_buf[] chunks ──
{% if has_output_concat %}
    // Bin-packing mode: single concatenation per entry (no multi-driver)
{% for expr in output_concat_exprs %}
    assign out_buf[{{ loop.index0 }}] = {{ expr }};
{% endfor %}
{%- else %}
{% for p in output_chunked %}
{% for c in p.chunks %}
{% set pad = WIDTH - (c.hi - c.lo + 1) %}
{% if pad > 0 %}
    assign out_buf[{{ c.bram_idx }}] = { {{ pad }}'d0, user_out_w_{{ p.name }}[{{ c.hi }}:{{ c.lo }}] };
{% else %}
    assign out_buf[{{ c.bram_idx }}] = user_out_w_{{ p.name }}[{{ c.hi }}:{{ c.lo }}];
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}

    // Handshake
    reg               user_start_wire;
    wire              user_done_wire;
{% if has_busy_port %}
    wire              user_busy_wire;
{% endif %}

    // ── Physical device adapter instantiation(s) ──
{% for ad in adapters %}
{% if ad.name == 'ps2' %}
    wire [63:0] ad_ps2_key_state;
    wire [7:0]  ad_ps2_mod_state;
    wire        ad_ps2_key_event;

    device_adapter_ps2 u_ps2_adapter (
        .clk        (clk),
        .rst_n      (rst_n),
        .ps2_clk    (ps2_clk),
        .ps2_data   (ps2_data),
        .key_state  (ad_ps2_key_state),
        .mod_state  (ad_ps2_mod_state),
        .key_event  (ad_ps2_key_event)
    );
{% elif ad.name == 'uart' %}
    wire [7:0]  ad_uart_data_byte;
    wire        ad_uart_data_valid;

    device_adapter_uart #(.BAUD_DIV(108)) u_uart_adapter (
        .clk        (clk),
        .rst_n      (rst_n),
        .uart_rx    (uart_rx),
        .data_byte  (ad_uart_data_byte),
        .data_valid (ad_uart_data_valid)
    );
{% elif ad.name == 'gpio' %}
    wire        ad_gpio_gpio_event;

    device_adapter_gpio #(.EDGE(1)) u_gpio_adapter (
        .clk        (clk),
        .rst_n      (rst_n),
        .gpio_in    (gpio_in),
        .gpio_event (ad_gpio_gpio_event)
    );
{% endif %}
{% endfor %}

    // ── User module instantiation ──
    {{ top_module }} u_user (
{% if has_clock_port %}        .{{ clock_port }} (clk),
{% endif %}
{% if has_reset_port %}        .{{ reset_port }} ({% if reset_polarity == 'active_low' %}rst_n{% else %}~rst_n{% endif %}),
{% endif %}
{% for inp in input_chunked %}
        .{{ inp.name }}{% if inp.array_count > 1 %} (user_in_w_{{ inp.name }}){% else %} (user_in_w_{{ inp.name }}){% endif %}{% if not loop.last or output_chunked|length > 0 or control_input_ports|length > 0 or control_output_ports|length > 0 or user_has_handshake or adapter_input_ports|length > 0 %},{% endif %}
{% endfor %}
{# --no-sipo: data inputs are not serialized; tie them low so they are not
   left floating (they are still connected by name). #}
{% for inp in tied_input_ports %}
        .{{ inp.name }}    ({{ inp.width }}'d0){% if not loop.last or output_chunked|length > 0 or control_input_ports|length > 0 or control_output_ports|length > 0 or user_has_handshake or adapter_input_ports|length > 0 %},{% endif %}
{% endfor %}
{# flat list: the old nested loop used the inner loop.last, so the last port
   of a non-final adapter lost its comma (multi-adapter + no handshake). #}
{% for ap in adapter_inputs_flat %}
        .{{ ap.name }}    ({{ ap.wire }}){% if not loop.last or output_chunked|length > 0 or control_input_ports|length > 0 or control_output_ports|length > 0 or user_has_handshake %},{% endif %}
{% endfor %}
{% for outp in output_chunked %}
        .{{ outp.name }}{% if outp.array_count > 1 %} (user_out_w_{{ outp.name }}){% else %} (user_out_w_{{ outp.name }}){% endif %}{% if not loop.last or control_input_ports|length > 0 or control_output_ports|length > 0 or user_has_handshake %},{% endif %}
{% endfor %}
{% for cp in control_input_ports %}
        .{{ cp.name }}    (ctrl_{{ cp.name }}){% if not loop.last or control_output_ports|length > 0 or user_has_handshake %},{% endif %}
{% endfor %}
{% for cp in control_output_ports %}
        .{{ cp.name }}    (user_ctrl_out_{{ cp.name }}){% if not loop.last or user_has_handshake %},{% endif %}
{% endfor %}
{% if user_has_handshake %}
        .{{ start_port }}    (user_start_wire),
        .{{ done_port }}     (user_done_wire){% if has_busy_port %},
        .{{ busy_port }}     (user_busy_wire){% endif %}
{% endif %}
    );

    // ============================================================
    // Control FSM
    // ============================================================
    reg [2:0]         fsm_state;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            fsm_state        <= 0;     // C_IDLE
{% if input_count > 0 %}
            in_bram_rd_addr  <= 0;
{% endif %}
{% if output_count > 0 %}
            out_bram_wr_addr <= 0;
            out_bram_din     <= 0;
            out_bram_we      <= 1'b0;
            piso_start       <= 1'b0;
            piso_triggered   <= 1'b0;
{% endif %}
{% if user_has_handshake %}
            launch_idx       <= 0;
            launch_cap       <= 0;
            dump_idx         <= 0;
            launch_pipe      <= 2'd0;
{% endif %}
            // user.start must have a defined value before the first launch,
            // otherwise the user module sees X on start while idle.
            user_start_wire  <= 1'b0;
{% if input_count > 0 %}
            src_arm   <= 1'b0;
{% endif %}
        end else begin
{% if input_count > 0 %}
            src_arm <= 1'b0;     // default: clear pulse
            // Port-B read enable: only high during C_LAUNCH when we are
            // actually consuming the in_bram data.  Otherwise port B is
            // idle (ENB=0) so the Xilinx collision checker doesn't trip
            // when SIPO writes to the same address on port A.
            in_bram_re <= 1'b0;
{% if num_in_brams > 1 %}
            // Read-select pipeline: 1 cycle, matching the registered read
            in_bram_rd_sel_d1 <= in_bram_rd_sel;
{% endif %}
{% endif %}
{% if output_count > 0 %}
            out_bram_we <= 1'b0;
            piso_start  <= 1'b0;
{% if num_out_brams > 1 %}
            out_bram_rd_sel_d1 <= out_bram_rd_sel;
{% endif %}
            // Port-B read enable is LOW by default.  During C_DUMP, port A
            // writes exactly the addresses the idle PISO parks on, and a
            // same-address port-A-write / port-B-read in one cycle is
            // undefined ("Memory Collision Error" in the Xilinx models).
            // C_DONE raises it and waits one cycle before starting the PISO,
            // so the registered DOB is settled on the pre-read word.
            out_bram_re <= 1'b0;
{% endif %}

{% if user_has_handshake %}
            case (fsm_state)
                0: begin  // C_IDLE
{% if input_count > 0 %}
                    if (src_done) begin
                        fsm_state <= 1;  // C_LAUNCH
                        in_bram_rd_addr <= 0;
                        launch_idx <= 0;  // reset for next batch
                        launch_cap <= 0;
                        launch_pipe <= 2'd0;
                        // Pre-arm port-B read enable one cycle early so
                        // the BRAM is enabled in time for the first
                        // C_LAUNCH read (avoids 1-cycle stale-data penalty
                        // on Xilinx 7-series BRAMs).
                        in_bram_re <= 1'b1;
                    end
{% elif input_source == 'adapter' %}
                    // Bridge mode: wait for trigger key rising edge
                    // (src_done pulse = 1 cycle).  Each press re-runs
                    // the FSM from C_COMPUTING onwards.
                    if (src_done) begin
                        user_start_wire <= 1'b1;
                        fsm_state <= 2;  // C_COMPUTING
                    end
{% else %}
                    // No data inputs — pulse start directly
                    user_start_wire <= 1'b1;
                    fsm_state <= 2;  // C_COMPUTING
{% endif %}
                end

{% if input_count > 0 %}
                1: begin  // C_LAUNCH
                    in_bram_re <= 1'b1;
{% if pipeline_depth is defined and pipeline_depth <= 1 %}
                    // 1-cycle pipeline (generic/distributed RAM / Spartan-6)
                    case (launch_pipe)
                        1'd0: begin
                            if (launch_idx < INPUT_COUNT)
                                in_bram_rd_addr <= launch_idx;
                            launch_pipe <= 1'd1;
                        end
                        1'd1: begin
                            if (launch_idx < INPUT_COUNT) begin
                                in_bram_buf[launch_idx[IN_IDX_W-1:0]] <= in_bram_dob;
                                launch_idx <= launch_idx + 1;
                            end
                            launch_pipe <= 1'd0;
                            if (launch_idx == INPUT_COUNT - 1) begin
                                user_start_wire <= 1'b1;
                                fsm_state <= 2;  // C_COMPUTING
                            end
                        end
                        default: launch_pipe <= 1'd0;
                    endcase
{% else %}
                    // Pipelined launch: a new address is issued EVERY clock and the
                    // captured word trails it by exactly one cycle, so a frame of N
                    // words costs N+2 clocks instead of 3*N.  The BRAM's read
                    // latency is one clock (the address registered at the end of
                    // cycle A is valid on DOB during cycle A+1), which is what the
                    // real-primitive sweep in benchmark/xsim_check confirmed.
                    launch_pipe <= {launch_pipe[0], launch_issue};
                    if (launch_issue) begin
                        in_bram_rd_addr <= launch_idx;
                        launch_idx     <= launch_idx + 1'b1;
                    end
                    if (launch_pipe[1]) begin
                        in_bram_buf[launch_cap[IN_IDX_W-1:0]] <= in_bram_dob;
                        launch_cap <= launch_cap + 1'b1;
                        if (launch_cap == INPUT_COUNT - 1) begin
                            user_start_wire <= 1'b1;
                            fsm_state <= 2;  // C_COMPUTING
                        end
                    end
{% endif %}
                end
{% endif %}

                2: begin  // C_COMPUTING
                    user_start_wire <= 1'b0;
                    if (user_done_wire) begin
{% if output_count > 0 %}
                        dump_idx <= 0;
                        fsm_state <= 3;  // C_DUMP
{% else %}
                        fsm_state <= 4;  // C_DONE (no outputs)
{% endif %}
                    end
                end

{% if output_count > 0 %}
                3: begin  // C_DUMP
                    if (dump_idx < OUTPUT_COUNT) begin
                        out_bram_din     <= out_buf[dump_idx];
                        out_bram_we      <= 1'b1;
                        // single zero-extending assignment (two overlapping
                        // non-blocking assignments relied on last-write-wins)
                        out_bram_wr_addr <= dump_idx;
                        dump_idx <= dump_idx + 1;
                    end
                    if (dump_idx == OUTPUT_COUNT - 1)
                        fsm_state <= 4;  // C_DONE
                end

                4: begin  // C_DONE
                    // Enable port-B reads first: the registered DOB needs one
                    // clock with ENB=1 before the PISO's pre-read is valid.
                    out_bram_re <= 1'b1;
                    if (!piso_busy && !piso_triggered && out_bram_re) begin
                        piso_start <= 1'b1;
                        piso_triggered <= 1'b1;
                    end
                    if (piso_done) begin
{% if input_count > 0 %}
                        src_arm <= 1'b1;  // pulse SIPO reset for next batch
{% endif %}
                        piso_triggered <= 1'b0;  // clear for next PISO run
                        fsm_state <= 0;  // back to C_IDLE
                    end
                end
{% else %}
                4: begin  // C_DONE (no output PISO)
                    fsm_state <= 0;
                end
{% endif %}

                default: fsm_state <= 0;
            endcase
{% else %}
            // Pass-through mode (no handshake): single-cycle compute
            user_start_wire <= 1'b1;
            fsm_state <= 0;
{% endif %}
        end
    end

{% if expose_ready %}
    // Ready for the next frame: the input stage has been re-armed (src_arm)
    // and the FSM is back in IDLE, so the next frame's words will be stored
    // from entry 0.  Producers must gate their strobes with this signal.
    assign s_ready = (fsm_state == 0){% if input_count > 0 %} && !src_arm{% endif %};
{% endif %}

{% if debug %}
    assign overflow = {% if input_count > 0 or input_source == 'adapter' %}src_ovf{% else %}1'b0{% endif %};
    assign idle = (fsm_state == 0);
    assign busy = (fsm_state != 0){% if output_count > 0 %} || piso_busy{% endif %}{% if has_busy_port %} || user_busy_wire{% endif %};
{% endif %}

endmodule
