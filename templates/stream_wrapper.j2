/*==============================================================
 *  Description: Generated by UFDE+ Stream IP Generator
 *  File: {{ top_module }}__stream_wrapper.v
 *  Author: UFDE+ IP Generator
 *  Date: {{ generation_date }}
 *
 *  Wraps user module `{{ top_module }}` with SIPO/PISO/BRAM glue
 *  to expose a parallel-N-bit 3-wire serial interface.
 *
 *  External port (N = WIDTH = bit-width of each parallel word):
 *    s_data_in[N-1:0], s_clk_in, s_strobe_in
 *    s_data_out[N-1:0], s_clk_out, s_data_valid
 *    overflow, idle, busy
 *
 *  Internal: instantiates stream_sipo, stream_piso, the user
 *  module, and two dual-port BRAMs.
 *
 *  FSM (no IDLE_TIMEOUT — sipo_done triggers immediately):
 *    C_IDLE      → wait for sipo_done
 *    C_LAUNCH    → copy INPUT_COUNT words from in_bram to user_in_reg
 *    C_COMPUTING → pulse user.start, wait for user.done
 *    C_DUMP      → copy OUTPUT_COUNT words from user_out_wire to out_bram
 *    C_DONE      → trigger PISO
 *
 *  Companion files (must be compiled alongside):
 *    - {{ top_module }}__stream_sipo.v
 *    - {{ top_module }}__stream_piso.v
 *    - {{ top_module }}__stream_bram.v
 *    - {{ user_source }}  (user module)
 *=============================================================*/

module {{ wrapper_module }} (
    input  wire                  clk,
    input  wire                  rst_n,

    // Parallel input from Rabbit
    input  wire [{{ width - 1 }}:0]  s_data_in,
    input  wire                  s_clk_in,
    input  wire                  s_strobe_in,

    // Parallel output to Rabbit
    output wire [{{ width - 1 }}:0]  s_data_out,
    output wire                  s_clk_out,
    output wire                  s_data_valid
{%- if debug %}
,
    // Debug status
    output wire                  overflow,
    output wire                  idle,
    output wire                  busy
{%- endif %}
);

    parameter WIDTH        = {{ width }};
    parameter DEPTH        = {{ depth }};
    parameter ADDR_W       = {{ addr_w }};
    parameter INPUT_COUNT  = {{ input_count }};
    parameter OUTPUT_COUNT = {{ output_count }};
    parameter IN_IDX_W     = {{ input_count_idx_w }};
    parameter OUT_IDX_W    = {{ output_count_idx_w }};

    // ============================================================
    // SIPO: writes each strobed word from s_data_in to in_bram
    // ============================================================
    wire [ADDR_W-1:0]  sipo_addr;
    wire [WIDTH-1:0]   sipo_din;
    wire               sipo_we;
    wire [ADDR_W-1:0]  sipo_write_count;
    wire               sipo_done;
    wire               sipo_ovf;

    {{ top_module }}__stream_sipo u_sipo (
        .clk          (clk),
        .rst_n        (rst_n),
        .data_in      (s_data_in),
        .clk_in       (s_clk_in),
        .strobe_in    (s_strobe_in),
        .bram_addr    (sipo_addr),
        .bram_din     (sipo_din),
        .bram_we      (sipo_we),
        .write_count  (sipo_write_count),
        .done         (sipo_done),
        .overflow     (sipo_ovf)
    );

    // Input BRAM: SIPO writes Port A, wrapper reads Port B
    wire [WIDTH-1:0]   in_bram_doa_unused;
    wire [WIDTH-1:0]   in_bram_dob;

    {{ bram_module }} u_in_bram (
        .ADDRA(sipo_addr),
        .DIA  (sipo_din),
        .CLKA (clk),
        .ENA  (1'b1),
        .WEA  (sipo_we),
        .DOA  (in_bram_doa_unused),
        .ADDRB(in_bram_rd_addr),
        .DIB  ({WIDTH{1'b0}}),
        .CLKB (clk),
        .ENB  (1'b1),
        .WEB  (1'b0),
        .DOB  (in_bram_dob)
    );

    // ============================================================
    // User module: combinational inputs (driven from user_in_reg)
    // and outputs (sampled to user_out_wire)
    //
    // For array-typed user ports (e.g. `A [0:3][0:3]`), we
    // concatenate the flattened element registers in row-major order.
    // For scalar ports, we just connect the single reg.
    // ============================================================
    reg  [WIDTH-1:0]  user_in_reg  [0:INPUT_COUNT-1];
{% for p in user_output_data_port_names %}    wire [WIDTH-1:0]  user_out_{{ loop.index0 }};
{% endfor %}    reg               user_start_wire;
    wire              user_done_wire;
{% if has_busy_port %}    wire              user_busy_wire;
{% endif %}

    // Per-element wires for user data input ports.  Each user
    // module data port is connected to one element of the
    // user_in_reg[] array.  This works for both flat ports
    // (`a0..a15`) and 2D array ports whose dimensions are
    // flattened by the parser.
{% for p in user_input_data_port_names %}    wire [WIDTH-1:0]  user_in_w_{{ p.name }} = user_in_reg[{{ p.index }}];
{% endfor %}

    {{ top_module }} u_user (
        .clk        (clk),
        .rst_n      (rst_n),
{% for inp in user_input_data_port_names_grouped %}        .{{ inp.name }}    (user_in_w_{{ inp.name }}),
{% endfor %}{% for p in user_output_data_port_names %}{% set outer_out_idx2 = loop.index0 %}        .{{ p.name }}    (user_out_{{ outer_out_idx2 }}),
{% endfor %}        .{{ start_port }}    (user_start_wire),
        .{{ done_port }}     (user_done_wire){% if has_busy_port %},
        .{{ busy_port }}     (user_busy_wire){% endif %}
    );

    // Output BRAM: wrapper writes Port A, PISO reads Port B
    wire [WIDTH-1:0]   out_bram_doa_unused;
    wire [WIDTH-1:0]   out_bram_dob;

    {{ bram_module }} u_out_bram (
        .ADDRA(out_bram_wr_addr),
        .DIA  (out_bram_din),
        .CLKA (clk),
        .ENA  (1'b1),
        .WEA  (out_bram_we),
        .DOA  (out_bram_doa_unused),
        .ADDRB(piso_addr),
        .DIB  ({WIDTH{1'b0}}),
        .CLKB (clk),
        .ENB  (1'b1),
        .WEB  (1'b0),
        .DOB  (out_bram_dob)
    );

    // ============================================================
    // PISO: reads OUTPUT_COUNT words from out_bram and sends them out
    // ============================================================
    wire [ADDR_W-1:0]  piso_addr;
    wire [WIDTH-1:0]   piso_data_out;
    wire               piso_clk_out;
    wire               piso_data_valid;
    wire               piso_busy;
    wire               piso_done;
    reg                piso_start;
    reg                piso_triggered;  // latch: only trigger once per cycle

    assign s_data_out  = piso_data_out;
    assign s_clk_out   = piso_clk_out;
    assign s_data_valid = piso_data_valid;
{%- if debug %}
    assign overflow    = sipo_ovf;
{%- endif %}

    {{ top_module }}__stream_piso u_piso (
        .clk          (clk),
        .rst_n        (rst_n),
        .start        (piso_start),
        .bram_addr    (piso_addr),
        .bram_dout    (out_bram_dob),
        .s_data_out   (piso_data_out),
        .s_clk_out    (piso_clk_out),
        .s_data_valid (piso_data_valid),
        .busy         (piso_busy),
        .done         (piso_done)
    );

    // ============================================================
    // Control FSM
    // ============================================================
    reg [2:0]         fsm_state;
    reg [ADDR_W-1:0]  in_bram_rd_addr;
    reg [ADDR_W-1:0]  out_bram_wr_addr;
    reg [WIDTH-1:0]   out_bram_din;
    reg               out_bram_we;
{% if user_has_handshake %}
    reg [IN_IDX_W-1:0]  launch_idx;
    reg [OUT_IDX_W-1:0] dump_idx;
    reg [1:0]           launch_pipe;  // 0=set_addr, 1=wait, 2=capture
{% endif %}

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            fsm_state        <= 0;     // C_IDLE
            in_bram_rd_addr  <= 0;
            out_bram_wr_addr <= 0;
            out_bram_din     <= 0;
            out_bram_we      <= 1'b0;
            piso_start       <= 1'b0;
            piso_triggered   <= 1'b0;
{% if user_has_handshake %}
            launch_idx       <= 0;
            dump_idx         <= 0;
            launch_pipe      <= 2'd0;
{% endif %}
        end else begin
            out_bram_we <= 1'b0;
            piso_start  <= 1'b0;
            // piso_triggered is NOT cleared here — it's only cleared
            // on reset, ensuring PISO fires exactly once per FPGA config.

{% if user_has_handshake %}
            // FSM transitions
            case (fsm_state)
                0: begin  // C_IDLE
                    // Wait for SIPO to finish receiving INPUT_COUNT words
                    if (sipo_done) begin
                        fsm_state <= 1;  // C_LAUNCH
                        in_bram_rd_addr <= 0;
                    end
                end

                1: begin  // C_LAUNCH
                    // 3-phase BRAM read pipeline.
                    // BRAM registered read: dob_reg <= mem[ADDRB] at posedge.
                    // Non-blocking addr assignment adds 1 more cycle of delay.
                    // Total latency from "set addr" to "data on dob" = 2 cycles.
                    // Phase 0: set BRAM address.  Phase 1: wait for BRAM.
                    // Phase 2: capture in_bram_dob (now reflects addr from phase 0).
                    // First word uses 2 cycles (addr was primed during C_IDLE).
                    case (launch_pipe)
                        2'd0: begin
                            // Set address for next read
                            if (launch_idx < INPUT_COUNT) begin
                                in_bram_rd_addr <= launch_idx;
                            end
                            // First word: addr 0 was pre-loaded during C_IDLE,
                            // skip the wait state.
                            if (launch_idx == 0)
                                launch_pipe <= 2'd2;  // skip to capture
                            else
                                launch_pipe <= 2'd1;  // wait for BRAM
                        end
                        2'd1: begin
                            // Wait: BRAM samples address set in phase 0
                            launch_pipe <= 2'd2;
                        end
                        2'd2: begin
                            // Capture: in_bram_dob now holds the data
                            if (launch_idx < INPUT_COUNT) begin
                                user_in_reg[launch_idx[IN_IDX_W-1:0]] <= in_bram_dob;
                                launch_idx <= launch_idx + 1;
                            end
                            launch_pipe <= 2'd0;
                            if (launch_idx == INPUT_COUNT - 1) begin
                                user_start_wire <= 1'b1;
                                fsm_state <= 2;  // C_COMPUTING
                            end
                        end
                        default: launch_pipe <= 2'd0;
                    endcase
                end

                2: begin  // C_COMPUTING
                    user_start_wire <= 1'b0;  // deassert start pulse
                    if (user_done_wire) begin
                        dump_idx <= 0;
                        fsm_state <= 3;  // C_DUMP
                    end
                end

                3: begin  // C_DUMP
                    if (dump_idx < OUTPUT_COUNT) begin
                        out_bram_din     <= user_out_lookup;
                        out_bram_we      <= 1'b1;
                        out_bram_wr_addr <= 0;
                        out_bram_wr_addr[OUT_IDX_W-1:0] <= dump_idx;
                        dump_idx <= dump_idx + 1;
                    end
                    if (dump_idx == OUTPUT_COUNT - 1)
                        fsm_state <= 4;  // C_DONE
                end

                4: begin  // C_DONE
                    if (!piso_busy && !piso_triggered) begin
                        piso_start <= 1'b1;
                        piso_triggered <= 1'b1;
                    end
                    if (piso_done)
                        fsm_state <= 0;  // back to C_IDLE
                end

                default: fsm_state <= 0;
            endcase
{% else %}
            // Pass-through mode: not implemented in parallel version
            fsm_state <= 0;
{% endif %}
        end
    end

    // Combinational mux: select which user_out_* element to write to
    // out_bram.  dump_idx walks 0..OUTPUT_COUNT-1.
    wire [WIDTH-1:0] user_out_lookup;
    assign user_out_lookup =
{%- for p in user_output_data_port_names %}{% set outer_out_idx = loop.index0 %}
    (dump_idx == {{ p.index }}) ? user_out_{{ outer_out_idx }} :
{%- endfor %}
    {WIDTH{1'b0}};

{%- if debug %}
    // Debug status outputs
    assign idle = (fsm_state == 0);
    assign busy = (fsm_state != 0) || piso_busy
{%- if has_busy_port %} || user_busy_wire{% endif %};
{%- endif %}

endmodule
