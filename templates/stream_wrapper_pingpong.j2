/*==============================================================
 *  Description: Generated by SeriWrap
 *  File: {{ top_module }}__stream_wrapper.v  (PING-PONG MODE)
 *  Author: SeriWrap
 *  Date: {{ generation_date }}
 *
 *  Double-buffered (ping-pong) stream wrapper.
 *
 *  Architecture:
 *    - 2 input BRAMs  (in_bram_a, in_bram_b): SIPO fills one while
 *      the other is being read for computation
 *    - 2 output BRAMs (out_bram_a, out_bram_b): results written to
 *      one while the other is being drained by PISO
 *
 *  Scheduling (overlapped phases):
 *    Batch 0: SIPO→A | LAUNCH_A | COMPUTE | DUMP→C | PISO_C
 *    Batch 1:        | SIPO→B   | LAUNCH_B| COMPUTE| DUMP→D | PISO_D
 *    Batch 2:                   | SIPO→A  | LAUNCH_A| ...
 *
 *  This hides SIPO latency behind computation and PISO latency
 *  behind the next batch's computation, improving throughput
 *  for streaming workloads.
 *
 *  Companion files:
 *    - {{ top_module }}__stream_sipo.v
 *    - {{ top_module }}__stream_piso.v
 *    - {{ top_module }}__stream_bram.v (instantiated 4x)
 *    - {{ user_source }}  (user module)
 *=============================================================*/
`timescale 1ns / 1ps

{% set has_ctrl = control_input_ports|length > 0 or control_output_ports|length > 0 %}
{% set serial_ports = (input_count > 0) or (output_count > 0) %}

module {{ wrapper_module }} #(
    parameter WIDTH        = {{ WIDTH }},
    parameter DEPTH        = {{ depth }},
    parameter ADDR_W       = {{ addr_w }},
    parameter INPUT_COUNT  = {{ input_count }},
    parameter OUTPUT_COUNT = {{ output_count }},
    parameter IN_IDX_W     = {{ input_count_idx_w }},
    parameter OUT_IDX_W    = {{ output_count_idx_w }}
) (
    input  wire                  clk,
    input  wire                  rst_n{% if serial_ports or has_ctrl or debug or expose_ready %},{% endif %}
{%- if expose_ready %}

    // Back-pressure: HIGH while the wrapper can accept a new frame.
    output wire                  s_ready{% if serial_ports or has_ctrl or debug %},{% endif %}
{%- endif %}
{%- if input_count > 0 %}

    // Serial input from Rabbit
    input  wire [{{ WIDTH - 1 }}:0]  s_data_in,
    input  wire                  s_clk_in,
    input  wire                  s_strobe_in{% if output_count > 0 or has_ctrl or debug %},{% endif %}
{%- endif %}
{%- if output_count > 0 %}

    // Serial output to Rabbit
    output wire [{{ WIDTH - 1 }}:0]  s_data_out,
    output wire                  s_clk_out,
    output wire                  s_data_valid{% if has_ctrl or debug %},{% endif %}
{%- endif %}
{%- for cp in control_input_ports %}

    input  wire {% if cp.width > 1 %}[{{ cp.width - 1 }}:0] {% endif %} ctrl_{{ cp.name }}{% if not loop.last or control_output_ports|length > 0 or debug %},{% endif %}
{%- endfor %}
{%- for cp in control_output_ports %}

    output wire {% if cp.width > 1 %}[{{ cp.width - 1 }}:0] {% endif %} ctrl_{{ cp.name }}{% if not loop.last or debug %},{% endif %}
{%- endfor %}
{%- if debug %}

    output wire                  overflow,
    output wire                  idle,
    output wire                  busy
{%- endif %}
);

    // Forward-declare signals referenced by instantiations below.
    // xsim requires declaration before first use.
    reg               sel_bank;        // 0=A active, 1=B active (input side)
{% if input_count > 0 %}
    reg                src_arm;
    reg  [ADDR_W-1:0]  in_bram_rd_addr;
{% endif %}
{% if output_count > 0 %}
    reg  [ADDR_W-1:0]  out_bram_wr_addr;
    reg  [WIDTH-1:0]   out_bram_din;
    reg                out_bram_we;
    reg                out_bram_a_wr;
    reg                piso_sel_a;
    wire [ADDR_W-1:0]  piso_addr;
    reg                piso_start;
{% endif %}

{% if input_count > 0 %}
    // ============================================================
    // SIPO (single instance, writes to the active input BRAM)
    // ============================================================
    wire [ADDR_W-1:0]  src_addr;
    wire [WIDTH-1:0]   src_din;
    wire               src_we;
    wire [ADDR_W-1:0]  src_wcnt;
    wire               src_done;
    wire               src_ovf;

    // Route SIPO output to the active input BRAM
    wire [ADDR_W-1:0]  in_a_addra = sel_bank ? {ADDR_W{1'b0}} : src_addr;
    wire [WIDTH-1:0]   in_a_dia   = sel_bank ? {WIDTH{1'b0}}  : src_din;
    wire               in_a_wea   = sel_bank ? 1'b0            : src_we;
    wire [ADDR_W-1:0]  in_b_addra = sel_bank ? src_addr       : {ADDR_W{1'b0}};
    wire [WIDTH-1:0]   in_b_dia   = sel_bank ? src_din        : {WIDTH{1'b0}};
    wire               in_b_wea   = sel_bank ? src_we         : 1'b0;

    {{ top_module }}__stream_sipo u_sipo (
        .clk          (clk),
        .rst_n        (rst_n),
        .data_in      (s_data_in),
        .clk_in       (s_clk_in),
        .strobe_in    (s_strobe_in),
        .bram_addr    (src_addr),
        .bram_din     (src_din),
        .bram_we      (src_we),
        .write_count  (src_wcnt),
        .done         (src_done),
        .overflow     (src_ovf),
        .batch_arm    (src_arm)
    );

    // Input BRAM A — Port A: SIPO write, Port B: wrapper read.
    // Port-B ENB is LOW on the clock where this bank's port A is written
    // (src_we): a port-A write and a port-B read of the same address in one
    // clock is a same-address TDP collision — the Xilinx model reports it and
    // silicon leaves the read data undefined.  The bank that is NOT being
    // written keeps ENB high, so the launch reads are never disturbed.
    wire [WIDTH-1:0] in_bram_a_dob;
    {{ bram_module }} u_in_bram_a (
        .ADDRA(in_a_addra),  .DIA(in_a_dia),  .CLKA(clk), .ENA(1'b1), .WEA(in_a_wea),
        .DOA(/* unused */),  .DOB(in_bram_a_dob),
        .ADDRB(in_bram_rd_addr), .DIB({WIDTH{1'b0}}), .CLKB(clk),
        .ENB(sel_bank ? 1'b1 : ~src_we), .WEB(1'b0)
    );

    // Input BRAM B — Port A: SIPO write, Port B: wrapper read
    wire [WIDTH-1:0] in_bram_b_dob;
    {{ bram_module }} u_in_bram_b (
        .ADDRA(in_b_addra),  .DIA(in_b_dia),  .CLKA(clk), .ENA(1'b1), .WEA(in_b_wea),
        .DOA(/* unused */),  .DOB(in_bram_b_dob),
        .ADDRB(in_bram_rd_addr), .DIB({WIDTH{1'b0}}), .CLKB(clk),
        .ENB(sel_bank ? ~src_we : 1'b1), .WEB(1'b0)
    );

    // Mux: which input BRAM's Port B data is read
    wire [WIDTH-1:0] in_bram_dob = sel_bank ? in_bram_b_dob : in_bram_a_dob;
{% endif %}

{% if output_count > 0 %}
    // Output BRAM A — Port A: wrapper write, Port B: PISO read
    // ENB gated by ~out_bram_we: disable port-B reads while S_DUMP is
    // actively writing to port A to avoid RAMB36E1 TDP collision.
    wire [WIDTH-1:0] out_bram_a_dob;
    {{ bram_module }} u_out_bram_a (
        .ADDRA(out_bram_a_wr ? out_bram_wr_addr : {ADDR_W{1'b0}}),
        .DIA  (out_bram_a_wr ? out_bram_din    : {WIDTH{1'b0}}),
        .CLKA (clk), .ENA(1'b1), .WEA(out_bram_we & out_bram_a_wr),
        .DOA  (/* unused */), .DOB(out_bram_a_dob),
        // ENB: only the bank being written is disabled (to dodge the TDP
        // same-address collision warning); the OTHER bank must stay
        // readable because a PISO run may still be draining it while the
        // next batch is dumped.  Gating both banks froze the stream.
        .ADDRB(piso_addr), .DIB({WIDTH{1'b0}}), .CLKB(clk),
        .ENB(out_bram_a_wr ? ~out_bram_we : 1'b1), .WEB(1'b0)
    );

    // Output BRAM B — Port A: wrapper write, Port B: PISO read
    wire [WIDTH-1:0] out_bram_b_dob;
    {{ bram_module }} u_out_bram_b (
        .ADDRA(out_bram_a_wr ? {ADDR_W{1'b0}} : out_bram_wr_addr),
        .DIA  (out_bram_a_wr ? {WIDTH{1'b0}}    : out_bram_din),
        .CLKA (clk), .ENA(1'b1), .WEA(out_bram_we & ~out_bram_a_wr),
        .DOA  (/* unused */), .DOB(out_bram_b_dob),
        .ADDRB(piso_addr), .DIB({WIDTH{1'b0}}), .CLKB(clk),
        .ENB(out_bram_a_wr ? 1'b1 : ~out_bram_we), .WEB(1'b0)
    );

    // PISO reads from the "ready" output BRAM
    wire [WIDTH-1:0] out_bram_dob = piso_sel_a ? out_bram_a_dob : out_bram_b_dob;

    wire [WIDTH-1:0]   piso_data_out;
    wire               piso_clk_out;
    wire               piso_data_valid;
    wire               piso_busy;
    wire               piso_done;

    assign s_data_out   = piso_data_out;
    assign s_clk_out    = piso_clk_out;
    assign s_data_valid = piso_data_valid;

    {{ top_module }}__stream_piso u_piso (
        .clk(clk), .rst_n(rst_n), .start(piso_start),
        .bram_addr(piso_addr), .bram_dout(out_bram_dob),
        .s_data_out(piso_data_out), .s_clk_out(piso_clk_out),
        .s_data_valid(piso_data_valid), .busy(piso_busy), .done(piso_done)
    );
{% endif %}

    // ============================================================
    // User module I/O wires
    // ============================================================
{% if input_count > 0 %}
    reg  [WIDTH-1:0]  in_bram_buf [0:INPUT_COUNT-1];
{% endif %}
{% if output_count > 0 %}
    wire [WIDTH-1:0]  out_buf [0:OUTPUT_COUNT-1];
{% endif %}

{% for p in input_chunked %}
    wire [{{ p.width - 1 }}:0] user_in_w_{{ p.name }};
{% for c in p.chunks %}
{% if c.port_hi is defined %}
    assign user_in_w_{{ p.name }}[{{ c.port_hi }}:{{ c.port_lo }}] = in_bram_buf[{{ c.bram_idx }}][{{ c.bram_hi }}:{{ c.bram_lo }}];
{% else %}
    assign user_in_w_{{ p.name }}[{{ c.hi }}:{{ c.lo }}] = in_bram_buf[{{ c.bram_idx }}][{{ c.hi - c.lo }}:0];
{% endif %}
{% endfor %}
{% endfor %}

{% for p in output_chunked %}
    wire [{{ p.width - 1 }}:0] user_out_w_{{ p.name }};
{% endfor %}

{% for cp in control_output_ports %}
    wire {% if cp.width > 1 %}[{{ cp.width - 1 }}:0] {% endif %} user_ctrl_out_{{ cp.name }};
    assign ctrl_{{ cp.name }} = user_ctrl_out_{{ cp.name }};
{% endfor %}

{%- if output_chunks_flat and output_chunks_flat|length > 0 and output_chunks_flat[0].port_hi is defined %}
    // Bin-packing mode: partial bit-range assignments
{% for i in range(output_count) %}
    assign out_buf[{{ i }}] = {WIDTH{1'b0}};
{% endfor %}
{% for c in output_chunks_flat %}
    assign out_buf[{{ c.bram_idx }}][{{ c.bram_hi }}:{{ c.bram_lo }}] = user_out_w_{{ c.port_name }}[{{ c.port_hi }}:{{ c.port_lo }}];
{% endfor %}
{%- else %}
{% for p in output_chunked %}
{% for c in p.chunks %}
{% set pad = WIDTH - (c.hi - c.lo + 1) %}
{% if pad > 0 %}
    assign out_buf[{{ c.bram_idx }}] = { {{ pad }}'d0, user_out_w_{{ p.name }}[{{ c.hi }}:{{ c.lo }}] };
{% else %}
    assign out_buf[{{ c.bram_idx }}] = user_out_w_{{ p.name }}[{{ c.hi }}:{{ c.lo }}];
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}

    reg               user_start_wire;
    wire              user_done_wire;
{% if has_busy_port %}
    wire              user_busy_wire;
{% endif %}

    {{ top_module }} u_user (
        .clk(clk), .rst_n(rst_n),
{% for inp in input_chunked %}
        .{{ inp.name }}(user_in_w_{{ inp.name }}){% if not loop.last or output_chunked|length > 0 or control_input_ports|length > 0 or control_output_ports|length > 0 or user_has_handshake %},{% endif %}
{% endfor %}
{% for outp in output_chunked %}
        .{{ outp.name }}(user_out_w_{{ outp.name }}){% if not loop.last or control_input_ports|length > 0 or control_output_ports|length > 0 or user_has_handshake %},{% endif %}
{% endfor %}
{% for cp in control_input_ports %}
        .{{ cp.name }}(ctrl_{{ cp.name }}){% if not loop.last or control_output_ports|length > 0 or user_has_handshake %},{% endif %}
{% endfor %}
{% for cp in control_output_ports %}
        .{{ cp.name }}(user_ctrl_out_{{ cp.name }}){% if not loop.last or user_has_handshake %},{% endif %}
{% endfor %}
{% if user_has_handshake %}
        .{{ start_port }}(user_start_wire),
        .{{ done_port }}(user_done_wire){% if has_busy_port %},
        .{{ busy_port }}(user_busy_wire){% endif %}
{% endif %}
    );

    // ============================================================
    // Ping-Pong Control FSM
    // ============================================================
    reg [3:0]         fsm_state;
{% if user_has_handshake %}
    reg [IN_IDX_W-1:0]  launch_idx;
    reg [OUT_IDX_W-1:0] dump_idx;
{% if pipeline_depth is not defined or pipeline_depth > 1 %}
    reg [1:0]           launch_pipe;
{% else %}
    reg                 launch_pipe;
{% endif %}
    reg [1:0]           settle_cnt;
{% endif %}
{% if input_count > 0 %}
    // Edge-triggered latch: capture the rising edge of src_done so the
    // 1-cycle pulse is not missed during COMPUTING/DUMP phases.
    reg               src_done_prev;
    reg               src_done_latched;
{% endif %}

    // States
    localparam S_IDLE       = 4'd0;
    localparam S_LAUNCH     = 4'd1;
    localparam S_COMPUTING  = 4'd2;
    localparam S_DUMP       = 4'd3;
    localparam S_PISO_TRIG  = 4'd4;
    localparam S_WAIT_FLUSH = 4'd5;
    localparam S_PISO_SETTLE = 4'd6;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            fsm_state        <= S_IDLE;
{% if input_count > 0 %}
            in_bram_rd_addr  <= 0;
{% endif %}
{% if output_count > 0 %}
            out_bram_wr_addr <= 0;
            out_bram_din     <= 0;
            out_bram_we      <= 1'b0;
            piso_start       <= 1'b0;
            out_bram_a_wr    <= 1'b1;
            piso_sel_a       <= 1'b1;
{% endif %}
            sel_bank         <= 1'b0;
{% if input_count > 0 %}
            src_done_latched <= 1'b0;
            src_done_prev    <= 1'b0;
            src_arm    <= 1'b0;
{% endif %}
{% if user_has_handshake %}
            launch_idx       <= 0;
            dump_idx         <= 0;
            launch_pipe      <= 2'd0;
            settle_cnt       <= 2'd0;
{% endif %}
            // user.start must be defined while idle (was left uninitialised)
            user_start_wire  <= 1'b0;
        end else begin
{% if output_count > 0 %}
            out_bram_we <= 1'b0;
            piso_start  <= 1'b0;
{% endif %}
{% if input_count > 0 %}
            // Edge-triggered latch on src_done (1-cycle pulse). Hold
            // it set until the next LAUNCH consumes it.
            src_done_prev <= src_done;
            if (src_done && !src_done_prev)
                src_done_latched <= 1'b1;
            if (fsm_state == S_LAUNCH && launch_pipe == 2'd0 && launch_idx == 0)
                src_done_latched <= 1'b0;
            // Default: no batch reset. Pulsed high for 1 cycle in
            // S_WAIT_FLUSH entry to clear SIPO between batches.
            src_arm <= 1'b0;
{% endif %}

{% if user_has_handshake %}
            case (fsm_state)

                S_IDLE: begin
{% if input_count > 0 %}
                    if (src_done_latched) begin
                        in_bram_rd_addr <= 0;
                        fsm_state <= S_LAUNCH;
                    end
{% else %}
                    user_start_wire <= 1'b1;
                    fsm_state <= S_COMPUTING;
{% endif %}
                end

{% if input_count > 0 %}
                S_LAUNCH: begin
{% if pipeline_depth is defined and pipeline_depth <= 1 %}
                    // 1-cycle pipeline (generic/distributed RAM / Spartan-6)
                    case (launch_pipe)
                        1'd0: begin
                            if (launch_idx < INPUT_COUNT)
                                in_bram_rd_addr <= launch_idx;
                            launch_pipe <= 1'd1;
                        end
                        1'd1: begin
                            if (launch_idx < INPUT_COUNT) begin
                                in_bram_buf[launch_idx[IN_IDX_W-1:0]] <= in_bram_dob;
                                launch_idx <= launch_idx + 1;
                            end
                            launch_pipe <= 1'd0;
                            if (launch_idx == INPUT_COUNT - 1) begin
                                user_start_wire <= 1'b1;
                                fsm_state <= S_COMPUTING;
                            end
                        end
                        default: launch_pipe <= 1'd0;
                    endcase
{% else %}
                    // 3-cycle pipeline (7-series BRAM: ENB settle + read latency)
                    case (launch_pipe)
                        2'd0: begin
                            if (launch_idx < INPUT_COUNT)
                                in_bram_rd_addr <= launch_idx;
                            launch_pipe <= 2'd1;
                        end
                        2'd1: launch_pipe <= 2'd2;
                        2'd2: begin
                            if (launch_idx < INPUT_COUNT) begin
                                in_bram_buf[launch_idx[IN_IDX_W-1:0]] <= in_bram_dob;
                                launch_idx <= launch_idx + 1;
                            end
                            launch_pipe <= 2'd0;
                            if (launch_idx == INPUT_COUNT - 1) begin
                                user_start_wire <= 1'b1;
                                fsm_state <= S_COMPUTING;
                            end
                        end
                        default: launch_pipe <= 2'd0;
                    endcase
{% endif %}
                end
{% endif %}

                S_COMPUTING: begin
                    user_start_wire <= 1'b0;
                    if (user_done_wire) begin
{% if output_count > 0 %}
                        dump_idx <= 0;
                        fsm_state <= S_DUMP;
{% else %}
                        fsm_state <= S_WAIT_FLUSH;
{% endif %}
                    end
                end

{% if output_count > 0 %}
                S_DUMP: begin
                    if (dump_idx < OUTPUT_COUNT) begin
                        // Write c_i to BRAM, advance.
                        out_bram_din     <= out_buf[dump_idx];
                        out_bram_we      <= 1'b1;
                        out_bram_wr_addr <= 0;
                        out_bram_wr_addr[OUT_IDX_W-1:0] <= dump_idx;
                        dump_idx <= dump_idx + 1;
                    end
                    if (dump_idx == OUTPUT_COUNT - 1)
                        // Final write in flight; settle one cycle so
                        // out_bram_we transitions 1->0 (ENB rises) before
                        // the PISO captures bram_dout.
                        fsm_state <= S_PISO_SETTLE;
                end

                // Two-cycle settle: lets out_bram_we transition 1->0 (so ENB
                // rises) AND gives the BRAM's registered DOB 2 cycles of
                // ENB=1 before the PISO captures bram_dout.  Required
                // for real Xilinx 7-series primitives (RAMB18E1/RAMB36E1)
                // where the ENB 0->1 transition costs 1 extra cycle
                // before DOBDO is valid.  Behavioral stubs work with 1.
                S_PISO_SETTLE: begin
                    if (settle_cnt == 2'd0) begin
                        settle_cnt <= 2'd1;
                    end else begin
                        settle_cnt <= 2'd0;
                        fsm_state <= S_PISO_TRIG;
                    end
                end

                S_PISO_TRIG: begin
                    // !piso_busy is correct here: PISO is idle (not
                    // started yet), so we can arm it.  FSM leaves
                    // this state on the same cycle, so re-trigger is
                    // impossible regardless of level vs edge.
                    if (!piso_busy) begin
                        piso_start   <= 1'b1;
                        piso_sel_a   <= ~sel_bank;  // read the bank we just wrote
                        fsm_state    <= S_WAIT_FLUSH;
                    end
                end
{% endif %}

                S_WAIT_FLUSH: begin
                    // Toggle bank for next batch, and clear SIPO so it
                    // can accept the next batch from write_count = 0.
                    // strobe_sync is idle here (Rabbit has paused), so
                    // the SIPO's batch_arm window races against no inputs.
                    sel_bank       <= ~sel_bank;
{% if output_count > 0 %}
                    out_bram_a_wr  <= ~out_bram_a_wr;
{% endif %}
{% if input_count > 0 %}
                    src_arm <= 1'b1;
{% endif %}
                    launch_idx     <= 0;
{% if input_count > 0 %}
                    if (src_done_latched) begin
                        // Next batch already in the other BRAM
                        in_bram_rd_addr <= 0;
                        fsm_state <= S_LAUNCH;
                    end else begin
                        fsm_state <= S_IDLE;
                    end
{% else %}
                    fsm_state <= S_IDLE;
{% endif %}
                end

                default: fsm_state <= S_IDLE;
            endcase
{% else %}
            user_start_wire <= 1'b1;
            fsm_state <= S_IDLE;
{% endif %}
        end
    end

{% if expose_ready %}
    // Ready for the next frame (see the standard wrapper).
    assign s_ready = (fsm_state == S_IDLE){% if input_count > 0 %} && !src_arm{% endif %};
{% endif %}

{% if debug %}
    assign overflow = {% if input_count > 0 %}src_ovf{% else %}1'b0{% endif %};
    assign idle = (fsm_state == S_IDLE);
    assign busy = (fsm_state != S_IDLE){% if output_count > 0 %} || piso_busy{% endif %}{% if has_busy_port %} || user_busy_wire{% endif %};
{% endif %}

endmodule
