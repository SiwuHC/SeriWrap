/*==============================================================
 *  Description: Generated by SeriWrap
 *  File: {{ top_module }}__stream_wrapper.v  (REGISTER-FILE MODE)
 *  Author: SeriWrap
 *  Date: {{ generation_date }}
 *
 *  Register-file (zero-BRAM) stream wrapper for small kernels.
 *  Activated when INPUT_COUNT × WIDTH ≤ threshold (~512 bits).
 *
 *  Architecture:
 *    - Input:  SIPO writes directly to reg_file[0..INPUT_COUNT-1]
 *              User ports are combinationally connected — no LAUNCH.
 *    - Output: user outputs captured into out_reg_file in C_DUMP,
 *              then drained by PISO.
 *
 *  FSM (4 states, no LAUNCH):
 *    C_IDLE      → wait for src_done
 *    C_COMPUTING → pulse user.start, wait for user.done
 *    C_DUMP      → capture user outputs into out_reg_file
 *    C_DONE      → trigger PISO, then back to C_IDLE
 *
 *  Companion files:
 *    - {{ top_module }}__stream_sipo.v
 *    - {{ top_module }}__stream_piso.v
 *=============================================================*/
`timescale 1ns / 1ps

{% set has_ctrl = control_input_ports|length > 0 or control_output_ports|length > 0 %}
{% set serial_ports = (input_count > 0) or (output_count > 0) %}

module {{ wrapper_module }} (
    input  wire                  clk,
    input  wire                  rst_n{% if serial_ports or has_ctrl or debug or expose_ready %},{% endif %}
{%- if expose_ready %}

    // Back-pressure: HIGH while the wrapper can accept a new frame.
    output wire                  s_ready{% if serial_ports or has_ctrl or debug %},{% endif %}
{%- endif %}
{%- if input_count > 0 %}

    // Serial input
    input  wire [{{ WIDTH - 1 }}:0]  s_data_in,
    input  wire                  s_clk_in,
    input  wire                  s_strobe_in{% if output_count > 0 or has_ctrl or debug %},{% endif %}
{%- endif %}
{%- if output_count > 0 %}

    // Serial output
    output wire [{{ WIDTH - 1 }}:0]  s_data_out,
    output wire                  s_clk_out,
    output wire                  s_data_valid{% if has_ctrl or debug %},{% endif %}
{%- endif %}
{%- for cp in control_input_ports %}

    // Control input: {{ cp.name }}
    input  wire {% if cp.width > 1 %}[{{ cp.width - 1 }}:0] {% endif %} ctrl_{{ cp.name }}{% if not loop.last or control_output_ports|length > 0 or debug %},{% endif %}
{%- endfor %}
{%- for cp in control_output_ports %}

    // Control output: {{ cp.name }}
    output wire {% if cp.width > 1 %}[{{ cp.width - 1 }}:0] {% endif %} ctrl_{{ cp.name }}{% if not loop.last or debug %},{% endif %}
{%- endfor %}
{%- if debug %}

    // Debug status
    output wire                  overflow,
    output wire                  idle,
    output wire                  busy
{%- endif %}
);

    parameter WIDTH        = {{ WIDTH }};
    parameter INPUT_COUNT  = {{ input_count }};
    parameter OUTPUT_COUNT = {{ output_count }};
    // (IN_IDX_W/OUT_IDX_W are not needed here: register-file mode has no
    // marshaled-entry counters - see the single-cycle C_DUMP state.)

    // Registers that appear in instantiation port lists must be declared
    // BEFORE first use: Verilog-2001 implicitly declares an undeclared
    // identifier as a 1-bit wire, and a later "reg" declaration is then a
    // hard error in any non-SystemVerilog flow (Vivado xvlog, ModelSim vlog,
    // iverilog).  The old layout failed to compile there.
{% if output_count > 0 %}
    reg               piso_start;
    reg               piso_triggered;
{% endif %}
{% if input_count > 0 %}
    reg               src_arm;
{% endif %}

{% if input_count > 0 %}
    // ============================================================
    // SIPO → register file (zero-BRAM input path)
    // ============================================================
    reg  [WIDTH-1:0]  in_reg_file [0:INPUT_COUNT-1];

    wire [{{ addr_w - 1 }}:0]  src_addr;
    wire [WIDTH-1:0]           src_din;
    wire                       src_we;
    wire [{{ addr_w - 1 }}:0]  src_wcnt;
    wire                       src_done;
    wire                       src_ovf;

    always @(posedge clk) begin
        if (src_we) begin
            in_reg_file[src_addr] <= src_din;
        end
    end

    {{ top_module }}__stream_sipo u_sipo (
        .clk          (clk),
        .rst_n        (rst_n),
        .data_in      (s_data_in),
        .clk_in       (s_clk_in),
        .strobe_in    (s_strobe_in),
        .bram_addr    (src_addr),
        .bram_din     (src_din),
        .bram_we      (src_we),
        .write_count  (src_wcnt),
        .done         (src_done),
        .overflow     (src_ovf),
        .batch_arm    (src_arm)
    );
{% endif %}

{% if output_count > 0 %}
    // ============================================================
    // Output register file → PISO
    // ============================================================
    reg  [WIDTH-1:0]  out_reg_file [0:OUTPUT_COUNT-1];

    wire [WIDTH-1:0]   out_reg_read_data;
    reg  [{{ addr_w - 1 }}:0]  piso_rd_addr_reg;
    assign out_reg_read_data = out_reg_file[piso_rd_addr_reg];

    wire [WIDTH-1:0]   piso_data_out;
    wire               piso_clk_out;
    wire               piso_data_valid;
    wire               piso_busy;
    wire               piso_done;

    assign s_data_out   = piso_data_out;
    assign s_clk_out    = piso_clk_out;
    assign s_data_valid = piso_data_valid;

    // PISO reads from register file instead of BRAM.
    // Use a simple address counter driven by PISO's bram_addr.
    wire [{{ addr_w - 1 }}:0]  piso_addr;
    always @(posedge clk) begin
        piso_rd_addr_reg <= piso_addr;
    end

    {{ top_module }}__stream_piso u_piso (
        .clk(clk), .rst_n(rst_n), .start(piso_start),
        .bram_addr(piso_addr), .bram_dout(out_reg_read_data),
        .s_data_out(piso_data_out), .s_clk_out(piso_clk_out),
        .s_data_valid(piso_data_valid), .busy(piso_busy), .done(piso_done)
    );
{% endif %}

    // ============================================================
    // User module I/O wires
    // ============================================================
{% for p in input_chunked %}
    wire [{{ p.width - 1 }}:0] user_in_w_{{ p.name }};
{% for c in p.chunks %}
{% if c.port_hi is defined %}
    assign user_in_w_{{ p.name }}[{{ c.port_hi }}:{{ c.port_lo }}] = in_reg_file[{{ c.bram_idx }}][{{ c.bram_hi }}:{{ c.bram_lo }}];
{% else %}
    assign user_in_w_{{ p.name }}[{{ c.hi }}:{{ c.lo }}] = in_reg_file[{{ c.bram_idx }}][{{ c.hi - c.lo }}:0];
{% endif %}
{% endfor %}
{% endfor %}

{% for p in output_chunked %}
    wire [{{ p.width - 1 }}:0] user_out_w_{{ p.name }};
{% endfor %}

{% for cp in control_output_ports %}
    wire {% if cp.width > 1 %}[{{ cp.width - 1 }}:0] {% endif %} user_ctrl_out_{{ cp.name }};
    assign ctrl_{{ cp.name }} = user_ctrl_out_{{ cp.name }};
{% endfor %}

    reg               user_start_wire;
    wire              user_done_wire;
{% if has_busy_port %}
    wire              user_busy_wire;
{% endif %}

    {{ top_module }} u_user (
{% if has_clock_port %}        .{{ clock_port }} (clk),
{% endif %}
{% if has_reset_port %}        .{{ reset_port }} ({% if reset_polarity == 'active_low' %}rst_n{% else %}~rst_n{% endif %}),
{% endif %}
{% for inp in input_chunked %}
        .{{ inp.name }} (user_in_w_{{ inp.name }}){% if not loop.last or output_chunked|length > 0 or control_input_ports|length > 0 or control_output_ports|length > 0 or user_has_handshake %},{% endif %}
{% endfor %}
{% for outp in output_chunked %}
        .{{ outp.name }} (user_out_w_{{ outp.name }}){% if not loop.last or control_input_ports|length > 0 or control_output_ports|length > 0 or user_has_handshake %},{% endif %}
{% endfor %}
{% for cp in control_input_ports %}
        .{{ cp.name }}    (ctrl_{{ cp.name }}){% if not loop.last or control_output_ports|length > 0 or user_has_handshake %},{% endif %}
{% endfor %}
{% for cp in control_output_ports %}
        .{{ cp.name }}    (user_ctrl_out_{{ cp.name }}){% if not loop.last or user_has_handshake %},{% endif %}
{% endfor %}
{% if user_has_handshake %}
        .{{ start_port }}    (user_start_wire),
        .{{ done_port }}     (user_done_wire){% if has_busy_port %},
        .{{ busy_port }}     (user_busy_wire){% endif %}
{% endif %}
    );

    // ============================================================
    // Control FSM (4 states — no LAUNCH)
    // ============================================================
    reg [2:0]         fsm_state;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            fsm_state        <= 0;     // C_IDLE
{% if output_count > 0 %}
            piso_start       <= 1'b0;
            piso_triggered   <= 1'b0;
{% endif %}
{% if input_count > 0 %}
            src_arm          <= 1'b0;
{% endif %}
            // user.start must be defined while idle (was left uninitialised)
            user_start_wire  <= 1'b0;
        end else begin
{% if input_count > 0 %}
            src_arm <= 1'b0;     // default: clear pulse
{% endif %}
{% if output_count > 0 %}
            piso_start <= 1'b0;
{% endif %}

{% if user_has_handshake %}
            case (fsm_state)
                0: begin  // C_IDLE
{% if input_count > 0 %}
                    if (src_done) begin
                        user_start_wire <= 1'b1;
                        fsm_state <= 2;  // C_COMPUTING (skip LAUNCH)
                    end
{% else %}
                    user_start_wire <= 1'b1;
                    fsm_state <= 2;  // C_COMPUTING
{% endif %}
                end

                2: begin  // C_COMPUTING
                    user_start_wire <= 1'b0;
                    if (user_done_wire) begin
{% if output_count > 0 %}
                        fsm_state <= 3;  // C_DUMP
{% else %}
                        fsm_state <= 4;  // C_DONE (no outputs)
{% endif %}
                    end
                end

{% if output_count > 0 %}
                3: begin  // C_DUMP — capture user outputs into out_reg_file
                    // Register-file mode has no BRAM read latency: every output
                    // chunk is captured in ONE clock (kernel outputs are stable
                    // once done is asserted).  The old code repeated the same
                    // full capture OUTPUT_COUNT times, costing OUTPUT_COUNT-1
                    // extra cycles per invocation.
                    begin
                        // One FULL-WIDTH assignment per word (fields in bit order,
                        // gaps padded with zeros) — see _output_word_assigns().
{% for idx, expr in out_word_assigns %}
                        out_reg_file[{{ idx }}] <= {{ expr }};
{% endfor %}
                    end
                    fsm_state <= 4;  // C_DONE
                end

                4: begin  // C_DONE
                    if (!piso_busy && !piso_triggered) begin
                        piso_start <= 1'b1;
                        piso_triggered <= 1'b1;
                    end
                    if (piso_done) begin
{% if input_count > 0 %}
                        src_arm <= 1'b1;  // pulse SIPO reset for next batch
{% endif %}
                        piso_triggered <= 1'b0;
                        fsm_state <= 0;  // back to C_IDLE
                    end
                end
{% else %}
                4: begin  // C_DONE (no output PISO)
                    fsm_state <= 0;
                end
{% endif %}

                default: fsm_state <= 0;
            endcase
{% else %}
            // Pass-through mode (no handshake)
            user_start_wire <= 1'b1;
            fsm_state <= 0;
{% endif %}
        end
    end

{% if expose_ready %}
    // Ready for the next frame (see the standard wrapper).
    assign s_ready = (fsm_state == 0){% if input_count > 0 %} && !src_arm{% endif %};
{% endif %}

{% if debug %}
    assign overflow = {% if input_count > 0 %}src_ovf{% else %}1'b0{% endif %};
    assign idle = (fsm_state == 0);
    assign busy = (fsm_state != 0) || piso_busy{% if has_busy_port %} || user_busy_wire{% endif %};
{% endif %}

endmodule
